{
    "name": "@ptensor/tensor-desktop",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Desktop app for displaying tensors streamed by p10::tlog module.",
    "scripts": {
        "icons": "bun scripts/makeIcons.ts",
        "dev": "bun scripts/buildDecodeWorker.ts && bun scripts/makeIcons.ts && electrobun dev",
        "dev/ui": "bun scripts/buildDecodeWorker.ts && bun scripts/devUi.ts",
        "start": "electrobun run",
        "build": "bun scripts/buildDecodeWorker.ts && bun scripts/makeIcons.ts && electrobun build",
        "typecheck": "bun scripts/buildDecodeWorker.ts && bun scripts/typecheck.ts",
        "test": "bun scripts/buildDecodeWorker.ts && bun test",
        "test/send": "bun scripts/sendTensor.ts",
        "worker": "bun scripts/buildDecodeWorker.ts"
    },
    "dependencies": {
        "@cliffy/command": "npm:@jsr/cliffy__command",
        "@logtape/file": "^2.3.3",
        "@logtape/logtape": "^2.3.3",
        "@ptensor/tensor-view": "workspace:*",
        "electrobun": "1.18.1",
        "ptensor-tlog": "workspace:*",
        "ptensor-ts": "file:../../../ptensor-ts",
        "react": "^19.1.0",
        "react-dom": "^19.1.0"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "^20.12.0",
        "@types/bun": "^1.3.8",
        "@types/pngjs": "^6.0.5",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "@vitejs/plugin-react": "^4.3.4",
        "png-to-ico": "^3.0.2",
        "pngjs": "^7.0.0",
        "typescript": "^5.9.3",
        "vite": "^6.0.7"
    }
}
