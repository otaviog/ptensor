{
  "name": "ptensor-tlog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The p10::tlog wire protocol and the sockets that serve it: framing, message parsing and session tracking, plus a Bun and a node:net server.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./bun": {
      "import": {
        "types": "./dist/esm/bun/server.d.ts",
        "default": "./dist/esm/bun/server.js"
      },
      "require": {
        "types": "./dist/cjs/bun/server.d.ts",
        "default": "./dist/cjs/bun/server.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/esm/node/server.d.ts",
        "default": "./dist/esm/node/server.js"
      },
      "require": {
        "types": "./dist/cjs/node/server.d.ts",
        "default": "./dist/cjs/node/server.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node ./scripts/fixup-cjs.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.esm.json",
    "test": "bun test"
  },
  "dependencies": {
    "ptensor-ts": "file:../../../ptensor-ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "@types/bun": "^1.3.8"
  }
}
